// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  title        String
  subtitle     String?
  excerpt      String?
  heroImageUrl String
  videoUrl     String?
  contentHtml  String
  author       String?
  category     String?
  published    Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  galleryItems GalleryItem[]
  locationId   Int?
  location     Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([locationId])
}

// Um local (cidade ou país) no mapa. Uma reportagem é vinculada a um
// Location; vários locais podem acumular várias reportagens cada.
model Location {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  lat       Float
  lng       Float
  createdAt DateTime  @default(now())
  articles  Article[]
}

// Uma miniatura da galeria da matéria: clicar nela abre o vídeo vinculado
// em um popup (mesmo comportamento da imagem de destaque, mas com várias).
model GalleryItem {
  id        Int      @id @default(autoincrement())
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  imageUrl  String
  videoUrl  String?
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([articleId])
}
