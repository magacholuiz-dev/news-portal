# Postgres (Prisma Postgres, Neon, etc.)
DATABASE_URL=""

# Admin auth
ADMIN_USER="admin"
# Gere o hash com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 10))"
# IMPORTANTE: o Next.js expande "$" em arquivos .env — escape cada "$" do hash como "\$".
ADMIN_PASSWORD_HASH=""
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Upload de imagens (Vercel Blob) — gerado automaticamente ao rodar
# `vercel blob create-store` e linkar o projeto.
BLOB_READ_WRITE_TOKEN=""

# Mapa da home (MapTiler) — chave pública, gratuita, sem cartão de
# crédito: https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=""
